# Vercel builds the Next.js app in web/ (see vercel.json). Its prebuild step
# (web/scripts/sync-data.mjs) copies the root question banks + embeddings into
# web/public/data, so those JSON files must stay uploaded. Keep the Python
# pipeline, docs, tests, prototypes, generated indexes and source books out.
pipeline
docs
tests
prototypes
node_modules
_*.py
*.py
__pycache__
questions_embedded.json
og_pages.json
pdf_pages.json
*.pdf
*.epub
*.md
*.bat
*.toml
requirements*.txt
.prettierrc
.claude
memory
.git

# Local secrets: the tutor key comes from Vercel env vars, never from an uploaded file
.env
.env.*
