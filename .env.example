# Copy to .env.local (gitignored) and fill in. Used by scripts/tutor-proxy.mjs
# locally and by api/tutor.js on Vercel (set it in Project Settings → Environment
# Variables there — never commit a real key).
NVIDIA_API_KEY=nvapi-...
# Optional: override the model served by the tutor
# NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
