# Public browser identifiers (Supabase is used by the browser for Auth only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080

# Java backend only. Never prefix these values with NEXT_PUBLIC_.
DATABASE_URL=jdbc:postgresql://your-host:5432/postgres?sslmode=require
DATABASE_USERNAME=your-database-user
DATABASE_PASSWORD=your-database-password
SUPABASE_JWKS_URI=https://your-project.supabase.co/auth/v1/.well-known/jwks.json
FRONTEND_ORIGIN=http://localhost:3000
DB_POOL_SIZE=5
DB_MIN_IDLE=1

# Internal API gateway -> RAG service connection. Use one long random value for
# RAG_INTERNAL_TOKEN in both Java processes outside local development.
RAG_SERVICE_URL=http://localhost:8081
RAG_INTERNAL_TOKEN=replace-with-a-long-random-internal-token

# RAG service only. Never expose these values to the browser.
NVIDIA_API_KEY=your-provider-key
NVIDIA_MODEL=nvidia/nemotron-3-ultra-550b-a55b
RAG_MINIMUM_SCORE=0.28
RAG_DB_POOL_SIZE=3
RAG_DB_MIN_IDLE=1

# API gateway -> progress service. Use the same long random token in both
# Java processes outside local development.
PROGRESS_SERVICE_URL=http://localhost:8082
PROGRESS_INTERNAL_TOKEN=replace-with-a-long-random-internal-token
OUTBOX_POLL_DELAY_MS=500
OUTBOX_BATCH_SIZE=50
PROGRESS_DB_POOL_SIZE=3
PROGRESS_DB_MIN_IDLE=1
